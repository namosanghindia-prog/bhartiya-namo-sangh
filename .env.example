# ============================================
# Bhartiya Namo Sangh — Environment Variables
# ============================================
# Copy this file to .env.local for local development,
# and add these same values in Vercel → Project → Settings → Environment Variables

# --- Supabase (Database + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://prkfshuqdhjaxkuzjrwn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Upstash Redis (Homepage Slider storage) ---
# On Vercel: Storage tab → Create Database → Upstash Redis (or Marketplace →
# search "Redis"). These two vars are auto-injected once connected.
# Locally: leave unset — the app falls back to a local JSON file automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Keep-alive cron (prevents Supabase Free-plan 7-day pause) ---
# Optional but recommended. Set any long random string here AND in Vercel.
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to /api/keep-alive;
# when it is unset the route stays open (it only reads one row, so that is safe,
# but setting it stops anyone else from invoking it).
CRON_SECRET=

# --- Razorpay (Donations) — not yet connected ---
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_SECRET=

# --- Email (Resend) ---
# Transactional mail the organisation sends: welcome, application approved,
# membership activated, donation receipt. Create the key at
# resend.com → API Keys. With it unset, every send is skipped with a log line
# and nothing else breaks, so local development needs no key.
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend — resend.dev only
# delivers to the Resend account's own address.
EMAIL_FROM="Bhartiya Namo Sangh <noreply@bhartiyanamosangh.com>"
# Used for the links inside those emails. Defaults to the live domain.
NEXT_PUBLIC_SITE_URL=https://bhartiyanamosangh.com
# Where admin alerts go (new application, membership payment submitted).
# Optional: falls back to the primary email set in Admin → Settings → General.
ADMIN_EMAIL=

# Supabase's OWN auth mail (password reset, email change) does not use the key
# above. Point it at Resend's SMTP endpoint in the Supabase dashboard instead:
#   Project Settings → Authentication → SMTP Settings
#   Host: smtp.resend.com   Port: 465   User: resend   Pass: <RESEND_API_KEY>
