# ============================================
# Bhartiya Namo Sangh — Environment Variables
# ============================================
# Copy this file to .env.local for local development,
# and add these same values in Vercel → Project → Settings → Environment Variables

# --- Supabase (Database + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://prkfshuqdhjaxkuzjrwn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Upstash Redis (Homepage Slider storage) ---
# On Vercel: Storage tab → Create Database → Upstash Redis (or Marketplace →
# search "Redis"). These two vars are auto-injected once connected.
# Locally: leave unset — the app falls back to a local JSON file automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Keep-alive cron (prevents Supabase Free-plan 7-day pause) ---
# Optional but recommended. Set any long random string here AND in Vercel.
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>` to /api/keep-alive;
# when it is unset the route stays open (it only reads one row, so that is safe,
# but setting it stops anyone else from invoking it).
CRON_SECRET=

# --- Razorpay (Donations) — not yet connected ---
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_SECRET=

# --- Email (SendGrid/AWS SES) — not yet connected ---
# SENDGRID_API_KEY=
